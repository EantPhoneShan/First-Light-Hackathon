# Which sync backend to use: auto | local | aws | firebase
#  auto     = (default) aws if amplify_outputs.json exists, else local
#  local    = no cloud; solo play, and team mode across tabs of one browser (for testing)
#  aws      = AppSync + DynamoDB via Amplify Gen 2 (needs amplify_outputs.json)
#  firebase = Firebase Realtime Database (Plan B, fill in the values below)
VITE_SYNC=auto

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
